* text=auto eol=lf

# Generated from src/wire by `make schema`; never hand-edited.
# Conflicts are resolved by regenerating, not by merging hunks.
schema/*.json linguist-generated=true
schema/*.json -merge

# Generated from src/daemon/store/migrations and src/daemon/store/queries by
# `./build.py sql`; never hand-edited. Conflicts are resolved by regenerating.
src/daemon/store/queries/queries_gen.odin linguist-generated=true
src/daemon/store/queries/queries_gen.odin -merge

# Windows build scripts.
*.bat text eol=crlf
