#!/usr/bin/env sh
# Blocks commits with a stale schema. Installed via `./build.py setup`.
set -e

if git diff --cached --name-only | grep -qE '^(src/wire/|schema/)'; then
	if ! ./build.py schema-check; then
		echo "error: schema/wire.schema.json is stale or schema-test failed." >&2
		echo "       run './build.py schema' and stage the result, then commit again." >&2
		exit 1
	fi
fi
