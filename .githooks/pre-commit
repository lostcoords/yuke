#!/bin/sh
# Keep the generated protocol files in sync with the Zig types and generators.
# Run when the protocol, generators, build, or generated files are staged.
if git diff --cached --quiet -- lib/proto tools/protogen build.zig schema/proto.json src/js/app/generated/proto.d.ts; then
    exit 0
fi

zig build gen-schema || exit 1

if ! git diff --quiet -- schema/proto.json src/js/app/generated/proto.d.ts; then
    echo "error: the generated wire files were out of date and have been regenerated." >&2
    echo "       run 'git add schema/proto.json src/js/app/generated/proto.d.ts' and commit again." >&2
    exit 1
fi
