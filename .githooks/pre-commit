#!/bin/sh
# Keep schema/proto.json and the generated wire.d.ts in sync with the Zig wire types.
# Only run when the wire sources or the generated files are staged.
if git diff --cached --quiet -- lib/proto schema/proto.json src/js/app/generated/proto.d.ts; then
    exit 0
fi

zig build gen-schema || exit 1

if ! git diff --quiet -- schema/proto.json src/js/app/generated/proto.d.ts; then
    echo "error: the generated wire files were out of date and have been regenerated." >&2
    echo "       run 'git add schema/proto.json src/js/app/generated/proto.d.ts' and commit again." >&2
    exit 1
fi
