{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "types": [],

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,

    "paths": {
      "yuke": ["./facade.js"],
      "yuke:*": ["./*.js"]
    }
  },
  "include": ["./**/*.js", "./types/**/*.d.ts", "./generated/**/*.d.ts"]
}
