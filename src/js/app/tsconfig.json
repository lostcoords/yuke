{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "types": [],

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,

    "paths": {
      "yuke": ["./facade.js"],
      "yuke/ui": ["./public-ui.js"],
      "yuke/chat": ["./public-chat.js"],
      "yuke/plugins": ["./public-plugins.js"],
      "yuke:*": ["./*.js"]
    }
  },
  "include": ["./**/*.js", "./types/**/*.d.ts", "./generated/proto.d.ts"]
}
